ACTIVATE_ENV = "source workflow/envs/venv/bin/activate"
PYTHON = "python"

rule all:
    input:
        script="workflow/scripts/all.py"
    output:
        directory("plots/")
    threads: 16
    resources:
        nodes=1,
        mem_str="256gb",
        runtime=28800
    shell:
        "mkdir -p {output} && {ACTIVATE_ENV} && {PYTHON} {input.script}"
